{
  "name": "@goldennftplatform-svg/wallet-provider",
  "version": "1.1.0",
  "description": "LP-0021 reference Wallet Provider SDK, approval-gate CLI, and privacy-first proxy-only transport (mock adapters, local only)",
  "license": "MIT AND Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "src/provider.js",
  "exports": {
    ".": {
      "types": "./src/provider.d.ts",
      "default": "./src/provider.js"
    },
    "./provider.ts": "./src/provider.ts",
    "./transport": {
      "types": "./src/transport.d.ts",
      "default": "./src/transport.js"
    },
    "./net-adapters": {
      "types": "./src/net-adapters.d.ts",
      "default": "./src/net-adapters.js"
    }
  },
  "bin": {
    "proclaim-wallet": "./bin/proclaim-wallet.js"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "cli:demo": "node bin/proclaim-wallet.js demo",
    "cli:attack": "node bin/proclaim-wallet.js attack"
  },
  "dependencies": {},
  "devDependencies": {},
  "types": "src/provider.d.ts"
}
